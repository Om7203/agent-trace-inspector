{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-trace-inspector",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SERVICE_ENVIRONMENT": "production",
    "SERVICE_VERSION": "v0.1.0",
    "RATE_LIMIT_MAX": "30",
    "RATE_LIMIT_WINDOW_MS": "60000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITERS",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "env": {
    "staging": {
      "name": "agent-trace-inspector-staging",
      "vars": {
        "SERVICE_ENVIRONMENT": "staging",
        "SERVICE_VERSION": "v0.1.0",
        "RATE_LIMIT_MAX": "30",
        "RATE_LIMIT_WINDOW_MS": "60000"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITERS",
            "class_name": "RateLimiter"
          }
        ]
      }
    },
    "production": {
      "name": "agent-trace-inspector",
      "vars": {
        "SERVICE_ENVIRONMENT": "production",
        "SERVICE_VERSION": "v0.1.0",
        "RATE_LIMIT_MAX": "30",
        "RATE_LIMIT_WINDOW_MS": "60000"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITERS",
            "class_name": "RateLimiter"
          }
        ]
      }
    }
  }
}
